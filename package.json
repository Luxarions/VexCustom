{
  "name": "vexorion",
  "version": "1.0.0",
  "description": "Deterministic cryptographic primitives and data encoding toolkit",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./constants": "./src/core/Constants.js",
    "./errors": "./src/core/Errors.js",
    "./utils": "./src/core/Utils.js",
    "./constant-time": "./src/core/ConstantTime.js",
    "./random": "./src/core/Random.js",
    "./sha3": "./src/core/JsSha3.js",
    "./crypto": "./src/core/Crypto.js",
    "./bs58": "./src/core/Bs58.js",
    "./codec": "./src/core/Codec.js",
    "./string": "./src/core/String.js",
    "./bytes": "./src/core/Bytes.js",
    "./hash": "./src/core/Hash.js",
    "./vex": "./src/core/child/Vex.js"
  },
  "scripts": {
    "test": "node test/run-all.js",
    "typecheck": "tsc --noEmit",
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "crypto",
    "sha3",
    "keccak",
    "base58",
    "hex",
    "codec",
    "bytes",
    "deterministic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
