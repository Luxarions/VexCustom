{
  "name": "vexorion",
  "version": "1.0.0",
  "description": "Deterministic cryptographic primitives and data encoding toolkit",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./constants": "./src/core/Constants.js",
    "./errors": "./src/core/Errors.js",
    "./utils": "./src/core/Utils.js",
    "./constant-time": "./src/core/ConstantTime.js",
    "./random": "./src/core/Random.js",
    "./sha3": "./src/core/JsSha3.js",
    "./crypto": "./src/core/Crypto.js",
    "./bs58": "./src/core/Bs58.js",
    "./codec": "./src/core/Codec.js",
    "./string": "./src/core/String.js",
    "./bytes": "./src/core/Bytes.js",
    "./hash": "./src/core/Hash.js",
    "./vex": "./src/core/child/Vex.js"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "node build.js",
    "preview": "node server.js",
    "test": "node test/run-all.js && node test/puppeteer.js",
    "test:node": "node test/run-all.js",
    "test:puppeteer": "node test/puppeteer.js",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "crypto",
    "sha3",
    "keccak",
    "base58",
    "hex",
    "codec",
    "bytes",
    "deterministic"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "puppeteer": "^25.10.0",
    "typescript": "~5.8.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
